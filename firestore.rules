rules_version = '2';

// See You Soon — Firestore security rules.
// Only the two listed accounts can read or write anything. Every write is
// attributed to the signed-in person (never a name picked in the UI).
//
// >>> BEFORE DEPLOYING: put your two real email addresses below (lowercase). <<<
// They must match ALEX_EMAIL / TOBY_EMAIL in your Vercel environment.

service cloud.firestore {
  match /databases/{database}/documents {

    function memberEmails() {
      return {
        'alex@example.com': 'alex',
        'toby@example.com': 'toby'
      };
    }

    // Whose location is shown on the journey map (only they can update it).
    function travellerKey() {
      return 'alex';
    }

    // Keep in sync with ITEM_TYPES in src/config/app.ts.
    function itemTypes() {
      return ['activity', 'hotel', 'food', 'place', 'transport', 'other'];
    }

    function myKey() {
      return request.auth != null && request.auth.token.email is string
        ? memberEmails().get(request.auth.token.email.lower(), '')
        : '';
    }
    function isMember() { return myKey() != ''; }
    function d() { return request.resource.data; }
    function str(v, max) { return v is string && v.size() <= max; }
    function nonEmpty(v, max) { return str(v, max) && v.size() > 0; }
    function optStr(v, max) { return v == null || str(v, max); }
    function isDay(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDay(v) { return v == null || isDay(v); }
    function onlyChanged(keys) { return d().diff(resource.data).affectedKeys().hasOnly(keys); }
    function byMe() { return d().by == myKey(); }

    match /spaces/{space} {
      allow read: if isMember() && space == 'main';
      allow create, update: if isMember() && space == 'main'
        && nonEmpty(d().title, 60)
        && isDay(d().separationStart) && isDay(d().reunionDate)
        && isDay(d().tripStart) && isDay(d().tripEnd)
        && str(d().timezone, 64) && d().route is list && d().route.size() <= 30;
      allow delete: if false;

      // ---------- Wishlist ----------
      function validItem() {
        let x = d();
        return nonEmpty(x.title, 80)
          && x.type in itemTypes()
          && str(x.placeId, 64) && nonEmpty(x.placeName, 80)
          && optStr(x.description, 600)
          && optDay(x.desiredDate) && optDay(x.plannedDate)
          && optStr(x.url, 2000)
          && x.visited is bool
          && optStr(x.visitNote, 600);
      }

      match /items/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && validItem();
        // Anyone of the two can edit; the original author stays the author.
        allow update: if isMember() && d().by == resource.data.by && validItem();
        allow delete: if isMember();
      }

      match /places/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && nonEmpty(d().name, 80);
        allow update, delete: if false;
      }

      // ---------- Planner ----------
      match /travel/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && isDay(d().date) && nonEmpty(d().to, 80) && str(d().from, 80) && str(d().transport, 120);
        allow update: if isMember() && d().by == resource.data.by && isDay(d().date) && nonEmpty(d().to, 80);
        allow delete: if isMember();
      }

      // Arrival / departure anchors: editable, never deletable.
      match /fixed/{id} {
        allow read: if isMember();
        allow create, update: if isMember() && id in ['arrival', 'departure']
          && isDay(d().date) && nonEmpty(d().title, 100) && nonEmpty(d().city, 80) && str(d().note, 300);
        allow delete: if false;
      }

      // ---------- Memories ----------
      match /postcards/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe()
          && d().to in ['alex', 'toby'] && d().to != myKey()
          && nonEmpty(d().message, 1200) && str(d().title, 80) && str(d().place, 80)
          && d().readAt == null;
        // Only the recipient can mark it read; nothing else changes.
        allow update: if isMember() && resource.data.to == myKey() && onlyChanged(['readAt']);
        allow delete: if isMember() && resource.data.by == myKey();
      }

      match /moments/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && isDay(d().date) && str(d().caption, 300);
        allow update: if false;
        allow delete: if isMember();
      }

      // ---------- Signals ----------
      match /moods/{key} {
        allow read: if isMember();
        allow write: if isMember() && key == myKey();
      }

      match /status/{doc} {
        allow read: if isMember();
        allow write: if isMember() && doc == 'location' && myKey() == travellerKey();
      }

      match /events/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe()
          && d().type in ['postcard_created', 'wishlist_item_added', 'thinking_of_you', 'mood_updated',
                          'location_updated', 'planner_item_assigned', 'moment_added']
          && str(d().label, 120) && d().seen is map;
        // You may only mark events as seen for yourself.
        allow update: if isMember() && onlyChanged(['seen'])
          && d().seen.diff(resource.data.seen).affectedKeys().hasOnly([myKey()]);
        allow delete: if false;
      }

      // Per-person settings (push subscription). Readable by both so a notification can be sent.
      match /members/{key} {
        allow read: if isMember();
        allow write: if isMember() && key == myKey();
      }

      // ---------- Photos (compressed, stored as private documents) ----------
      match /images/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && d().data is string && d().data.size() < 1000000;
        allow update: if false;
        allow delete: if isMember();
      }
      match /thumbs/{id} {
        allow read: if isMember();
        allow create: if isMember() && byMe() && d().data is string && d().data.size() < 300000;
        allow update: if false;
        allow delete: if isMember();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
